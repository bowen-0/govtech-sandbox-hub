# Model credentials — set whichever provider matches CHAT_MODEL / ANALYSIS_MODEL below.
ANTHROPIC_API_KEY=your-anthropic-api-key
OPENAI_API_KEY=your-openai-api-key
# OPENAI_BASE_URL=https://openrouter.ai/api/v1   # if routing OpenAI-compatible via OpenRouter

# Optional: override the model strings used by src/simple_agent/graph.py.
# CHAT_MODEL drives the conversational profile-gathering + wiki Q&A loop.
# ANALYSIS_MODEL drives the structured risk-selection pass (used once per analysis run).
CHAT_MODEL=openai:gpt-4o-mini
ANALYSIS_MODEL=openai:gpt-4o

# Optional: absolute path to the wiki folder the agent reads from.
# Defaults to ../wiki relative to this package. Override when running the
# agent from somewhere other than the repo (e.g. inside a container).
# WIKI_ROOT=/absolute/path/to/govtech-hackathon/wiki

# Optional but recommended for tracing.
LANGSMITH_API_KEY=lsv2_...
