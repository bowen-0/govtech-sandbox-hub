{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sandbox-hub-agent",
  "main": "worker/index.ts",
  "compatibility_date": "2026-05-29",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "containers": [
    {
      "class_name": "LanggraphAgent",
      "image": "./Dockerfile",
      "max_instances": 2,
      "instance_type": "basic"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "class_name": "LanggraphAgent",
        "name": "AGENT"
      }
    ]
  },
  "migrations": [
    {
      "new_sqlite_classes": ["LanggraphAgent"],
      "tag": "v1"
    }
  ],
  "vars": {
    "OPENAI_BASE_URL": "https://openrouter.ai/api/v1",
    "SIMPLE_AGENT_MODEL": "openai:google/gemini-2.5-flash"
  }
  // Set as secrets before first deploy (NOT in vars):
  //   wrangler secret put OPENAI_API_KEY
  //   wrangler secret put ANTHROPIC_API_KEY   (optional fallback)
}
